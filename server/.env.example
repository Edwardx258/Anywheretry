# 复制为 .env 后填写。不要把 .env 提交到 Git。

PORT=3000

# Decart 平台 API Key（https://platform.decart.ai）。留空 = 演示模式：H5 只显示摄像头原画，不调用 AI。
DECART_API_KEY=

# 实时试穿模型
DECART_VTON_MODEL=lucy-vton-latest

# H5 试穿页的对外 https 源（协议+域名，不带路径），令牌只允许从这个源发起会话。
# 必须与小程序后台「业务域名」一致。本地开发可留空（不限制来源）。
TRYON_PUBLIC_ORIGIN=

# 单次实时试穿最长秒数（由 Decart 服务端强制断开）。实时视频按秒计费，务必设上限。
TRYON_MAX_SESSION_SECONDS=90

# 每个 IP 每天最多开启几次实时试穿
TRYON_DAILY_SESSIONS_PER_IP=10

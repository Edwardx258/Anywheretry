# 复制为 .env 后填写。不要把 .env 提交到 Git。

PORT=3000

# 服务对外可访问的 https 根地址（AI 接口需要能从公网拉取用户照片和服饰图）
# 本地开发可用内网穿透工具得到一个公网 https 地址
PUBLIC_BASE_URL=https://api.example.com

# 试衣服务提供方：mock（本地联调，不花钱）| dashscope（阿里云百炼 AI 试衣）
TRYON_PROVIDER=mock

# 阿里云百炼 API Key（TRYON_PROVIDER=dashscope 时必填）
DASHSCOPE_API_KEY=
# aitryon（基础版，更便宜更快）| aitryon-plus（效果更好）
DASHSCOPE_TRYON_MODEL=aitryon-plus

# 每个 IP 每天最多发起的试衣次数（AI 调用按次计费，防止被刷）
TRYON_DAILY_LIMIT_PER_IP=20

# 用户上传的人像照片保留多久（小时），到期自动删除
UPLOAD_RETENTION_HOURS=24

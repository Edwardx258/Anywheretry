# 复制为 .env 后填写。不要把 .env 提交到 Git。

PORT=3000

# ---------- 店铺 / 下单方式（网站不收款，引导顾客加微信下单） ----------
SHOP_NAME=AI 试衣间
# 顾客下单时添加的微信号（会显示在网站上，可一键复制）
ORDER_WECHAT_ID=
# 微信二维码图片：把图片放到 server/public/contact/ 下，这里填网址路径
ORDER_WECHAT_QR=/contact/wechat-qr.png
ORDER_NOTE=添加微信后发送商品名称和尺码，我们会尽快回复并安排发货。

# ---------- 实时试穿 ----------
# Decart 平台 API Key（https://platform.decart.ai）。留空 = 演示模式：试穿页只显示摄像头原画，不调用 AI。
DECART_API_KEY=

# 实时试穿模型
DECART_VTON_MODEL=lucy-vton-latest

# 试穿页的对外 https 源（协议+域名，不带路径），令牌只允许从这个源发起会话。
# 例如 https://www.example.com 。本地开发可留空（不限制来源）。
TRYON_PUBLIC_ORIGIN=

# 单次实时试穿最长秒数（由 Decart 服务端强制断开）。实时视频按秒计费，务必设上限。
TRYON_MAX_SESSION_SECONDS=90

# 每个 IP 每天最多开启几次实时试穿
TRYON_DAILY_SESSIONS_PER_IP=10

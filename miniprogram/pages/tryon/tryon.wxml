<view class="wrap" wx:if="{{product}}">
  <view class="product">
    <image class="thumb" src="{{product.cover}}" mode="aspectFill" />
    <view>
      <view class="pname">{{product.name}}</view>
      <view class="price">¥{{product.price}}</view>
    </view>
  </view>

  <!-- 结果 -->
  <view wx:if="{{stage === 'done'}}" class="result">
    <view class="img-box">
      <image class="result-img" src="{{resultUrl}}" mode="widthFix" bindtap="preview" />
      <!-- 按《互联网信息服务深度合成管理规定》需对 AI 生成内容做显著标识 -->
      <text class="ai-tag label">AI 生成效果图，仅供参考</text>
    </view>
    <view class="actions">
      <button class="btn-ghost" bindtap="save">保存图片</button>
      <button class="btn-ghost" open-type="share">发给朋友看看</button>
    </view>
    <button class="btn-ghost again" bindtap="choosePhoto">换一张照片</button>
  </view>

  <!-- 选择照片 / 生成中 -->
  <view wx:else>
    <view class="photo-box" bindtap="choosePhoto">
      <image wx:if="{{photoPath}}" class="photo" src="{{photoPath}}" mode="aspectFit" />
      <view wx:else class="placeholder">
        <view class="plus">＋</view>
        <view>上传一张你的全身照</view>
      </view>
    </view>

    <view class="tips">
      <view class="tips-title">拍照小贴士</view>
      <view>· 正面站立、全身入镜，画面里只有你一个人</view>
      <view>· 光线充足、背景简洁，穿贴身一点的衣服效果更好</view>
    </view>

    <view class="consent" bindtap="toggleConsent">
      <view class="checkbox {{consent ? 'on' : ''}}">{{consent ? '✓' : ''}}</view>
      <text>我同意上传本人照片用于生成试穿效果。照片含人脸等敏感个人信息，仅用于本次试穿，24 小时内自动删除，不会用于其他用途。</text>
    </view>

    <view wx:if="{{stage === 'uploading' || stage === 'generating'}}" class="progress">
      <view class="spinner"></view>
      <text>{{progressText}}</text>
    </view>
    <view wx:if="{{stage === 'error'}}" class="error">{{errorMsg}}</view>

    <button class="btn-primary go" bindtap="generate"
            disabled="{{stage === 'uploading' || stage === 'generating'}}">
      {{photoPath ? '开始 AI 试穿' : '选择照片'}}
    </button>
  </view>
</view>

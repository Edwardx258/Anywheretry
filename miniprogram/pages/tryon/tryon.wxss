.wrap { padding: 24rpx 32rpx 80rpx; }
.product { display: flex; gap: 20rpx; align-items: center; background: #fff; padding: 20rpx; border-radius: 16rpx; }
.thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #eee; }
.pname { font-weight: 600; margin-bottom: 6rpx; }
.photo-box { margin-top: 24rpx; height: 820rpx; background: #fff; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.photo { width: 100%; height: 100%; }
.placeholder { color: #999; text-align: center; }
.plus { font-size: 96rpx; line-height: 1.2; }
.tips { margin-top: 20rpx; font-size: 24rpx; color: #666; line-height: 1.8; }
.tips-title { color: #222; font-weight: 600; }
.consent { display: flex; gap: 16rpx; margin-top: 20rpx; font-size: 22rpx; color: #888; line-height: 1.6; }
.checkbox { flex: none; width: 32rpx; height: 32rpx; margin-top: 4rpx; border: 2rpx solid #999; border-radius: 6rpx; text-align: center; line-height: 32rpx; font-size: 24rpx; }
.checkbox.on { background: #222; border-color: #222; color: #fff; }
.progress { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; color: #555; }
.spinner { width: 32rpx; height: 32rpx; border: 4rpx solid #ddd; border-top-color: #222; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.error { margin-top: 24rpx; color: #e4393c; }
.go { margin-top: 32rpx; }
.result { margin-top: 24rpx; }
.img-box { position: relative; border-radius: 16rpx; overflow: hidden; background: #fff; }
.result-img { width: 100%; display: block; }
.label { position: absolute; right: 16rpx; bottom: 16rpx; }
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actions button { flex: 1; margin: 0; }
.again { margin-top: 20rpx; }

<block wx:if="{{product}}">
  <image class="hero" src="{{product.cover}}" mode="aspectFit" />
  <view class="info">
    <view class="price big">¥{{product.price}}</view>
    <view class="title">{{product.name}}</view>
    <view class="desc">{{product.description}}</view>
  </view>

  <view class="tryon-box">
    <view class="tryon-opt" bindtap="goLive">
      <view class="opt-name">📷 AI 实时试穿</view>
      <view class="opt-desc">打开摄像头，衣服实时“穿”在你身上，转身抬手都会跟着动，还能一键切换其他款式</view>
    </view>
  </view>

  <view class="bar">
    <button class="btn-ghost" bindtap="goLive">实时试穿</button>
    <button class="btn-primary" bindtap="buy">立即购买</button>
  </view>
</block>
